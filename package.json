{
  "name": "tracker",
  "version": "1.0.0",
  "description": "Tactical tracker: single-cabin auth, RFC 7946 GeoJSON, MapLibre HUD, hardware-to-pixel weld",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "cockpit": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "cockpit:build": "vite build"
  },
  "keywords": [
    "tracker",
    "maplibre-gl",
    "geojson",
    "rfc7946",
    "dead-reckoning",
    "cockpit",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "maplibre-gl": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.0.5"
  }
}
